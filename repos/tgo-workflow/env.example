# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tgo_workflow

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
WORKFLOW_QUEUE_NAME=workflow
# API, Worker and Beat must use the same queue and timer switch.
# Enable only after migrations, private authorization and worker checks pass.
TIMER_EXECUTION_ENABLED=false
# Keep API/Workflow/Worker switches aligned; enable only after migration and
# actual queue/worker/permission acceptance. Default accepts no notifications.
WEBHOOK_EXECUTION_ENABLED=false
# Webhook credentials require an independent JSON keyring (32+ bytes per key).
# Configure a generated key locally; retain old keys while credentials use them.
# No fallback to SECRET_KEY. Leave unset until registration is required.
WORKFLOW_WEBHOOK_KEYS=
WORKFLOW_WEBHOOK_ACTIVE_KEY_ID=

# Short-lived original AI answer recovery. Blank keys use SECRET_KEY (32+ bytes).
# Workflow API and Worker must retain the same keys during rotation.
WORKFLOW_AI_RESULT_KEYS=
WORKFLOW_AI_RESULT_ACTIVE_KEY_ID=
WORKFLOW_AI_RESULT_TTL_SECONDS=900

# Integrations
MAIN_SYSTEM_URL=http://localhost:3000
MAIN_SYSTEM_API_KEY=your_main_system_api_key

# LLM Keys
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

