# Common ports and credentials
POSTGRES_DB=tgo
POSTGRES_USER=tgo
POSTGRES_PASSWORD=tgo
POSTGRES_PORT=5432

ENVIRONMENT=PRODUCTION

# 域见 SaaS：迁移与现有企业核对完成后再启用。
SAAS_ENABLED=false
SAAS_NEW_PURCHASES_ENABLED=false
SAAS_BILLING_ENABLED=false
SAAS_REGISTRATION_ENABLED=false
SAAS_TRIAL_DAYS=7
SAAS_TRIAL_SEATS=3
SAAS_TRIAL_AI_REPLIES=100
SAAS_TRIAL_KNOWLEDGE_BYTES=104857600
SAAS_TRIAL_CHANNELS=2
SAAS_AI_MAX_CONCURRENT_REPLIES=5
SAAS_APPROVED_MODELS=[]
SAAS_MODEL_COST_RATES={}
SAAS_MAX_INPUT_CHARACTERS=64000
SAAS_MAX_OUTPUT_TOKENS=4096
SAAS_MAX_TOOL_CALLS=8
SAAS_MAX_HISTORY_RUNS=6
SAAS_API_INTERNAL_URL=http://tgo-api:8001
# Set a shared random SAAS_INTERNAL_TOKEN in private API/AI/RAG/platform config.
# Email links require your public HTTPS web origin and a configured SMTP sender.
SAAS_WEB_BASE_URL=
SAAS_SMTP_HOST=
SAAS_SMTP_PORT=465
SAAS_SMTP_USER=
SAAS_SMTP_FROM=
SAAS_SMTP_STARTTLS=false
# Set SAAS_SMTP_PASSWORD only in the private environment file.
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_CERT_SERIAL=
# Paths refer to files inside the API container; mount keys read-only.
WECHAT_PAY_PRIVATE_KEY_FILE=
WECHAT_PAY_TRUSTED_KEYS={}
# WECHAT_PAY_TRUSTED_KEYS maps each WeChat key ID/certificate serial to a PEM path.
# Set the exact 32-byte WECHAT_PAY_API_V3_KEY only in the private environment file.
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
# Required before SaaS activation: use the public API gateway, never raw IM.
# Example public URL: wss://support.example.com/api/v1/wukongim/ws
SAAS_IM_PUBLIC_URL=
SAAS_IM_UPSTREAM_URL=ws://wukongim:5200
SAAS_VISITOR_IM_TOKEN_MINUTES=1440
# Apply docker-compose.saas.yml to prevent clients bypassing the gateway.
OPS_ACCESS_TOKEN_MINUTES=15
# Independent operator login; requires the operator migration and OPS_SECRET_KEY.
OPS_ENABLED=false
MESSAGE_SEARCH_SCAN_LIMIT=5000
MESSAGE_SEARCH_TIMEOUT_SECONDS=10
# Message clients must authenticate; do not disable for a SaaS deployment.
WK_TOKENAUTHON=true
# Callback URL defaults to the internal API port in each Compose profile.
# Set WUKONGIM_WEBHOOK_URL only to a trusted internal address when needed.
# Set OPS_SECRET_KEY to an independent random secret (32+ characters).
# Keep the real value outside version control and do not reuse SECRET_KEY.

# API base URL (for frontend to call backend)
# When using Nginx reverse proxy, use the Nginx URL
VITE_WIDGET_PREVIEW_URL=/widget/
VITE_WIDGET_SCRIPT_BASE=/widget/tgo-widget-sdk.js
VITE_WIDGET_DEMO_URL=/widget/demo.html
VITE_API_BASE_URL=/api
VITE_DEBUG_MODE=false

# Store
STORE_SERVICE_URL=https://store.tgo.ai
STORE_WEB_URL=https://store.tgo.ai

# Redis port
REDIS_PORT=6379


# Service internal ports (not exposed to host, only accessible through Nginx)
# These are used for inter-service communication within Docker network
API_PORT=8000
AI_PORT=8002
PLATFORM_PORT=8003
RAG_PORT=8082
WEB_PORT=3000


# WuKongIM Config
WK_EXTERNAL_IP=
WK_EXTERNAL_TCPADDR=
WK_EXTERNAL_WSADDR=
WK_EXTERNAL_WSSADDR=

# ============================================
# Domain Configuration (Optional)
# ============================================
# Set these to enable domain-based access with Nginx reverse proxy
# Leave empty or commented out to use direct port access

# Domain names for services
WEB_DOMAIN=
WIDGET_DOMAIN=
API_DOMAIN=

# SSL Configuration
# Options: none (no SSL), auto (Let's Encrypt), manual (custom certificates)
SSL_MODE=none

# Let's Encrypt email (required for SSL_MODE=auto)
SSL_EMAIL=

# Enable automatic SSL certificate renewal (for SSL_MODE=auto)
ENABLE_SSL_AUTO_RENEW=true

# Nginx ports (only Nginx is exposed to host)
# All other services (tgo-api, tgo-web, tgo-widget-js) are only accessible through Nginx
NGINX_PORT=80
NGINX_SSL_PORT=443

# nginx file size limit
NGINX_CLIENT_MAX_BODY_SIZE=100m


# ============================================
# Storage Configuration
# ============================================
# STORAGE_TYPE options: local, oss, minio
STORAGE_TYPE=local

# Aliyun OSS Configuration
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET_NAME=your-bucket-name
# OSS_BUCKET_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret

# MinIO Configuration
# MINIO_URL=http://your-minio-host:9000
# MINIO_ACCESS_KEY_ID=your-access-key-id
# MINIO_SECRET_ACCESS_KEY=your-secret-access-key
# MINIO_BUCKET_NAME=your-bucket-name
# MINIO_UPLOAD_URL=http://internal-minio:9000
# MINIO_DOWNLOAD_URL=https://public-minio-domain.com


# ============================================
# SMTP Configuration (Optional - for email notifications)
# ============================================
# TGO_SMTP_HOST=smtp.example.com
# TGO_SMTP_PORT=587
# TGO_SMTP_USERNAME=your-username
# TGO_SMTP_PASSWORD=your-password
# TGO_SMTP_USE_TLS=true
# TGO_SMTP_FROM_ADDRESS=noreply@example.com


# ============================================
# Advanced Settings (Optional)
# ============================================
# Token expiration (default: 30 days = 43200 minutes)
# ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Maximum file upload size in MB (default: 20)
# MAX_UPLOAD_SIZE_MB=20

# Log level (default: INFO)
# LOG_LEVEL=INFO


